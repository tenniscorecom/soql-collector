; =====================================================
; 初回に 実行.bat を1度動かすと、このファイルをもとに config.ini が作られて、
;   「値を書き換えてから、もう一度実行してください」と出て止まります。
;   そのあと config.ini（このファイルではない方）を開いて、実際の値に書き換える。
;
; ここに書くもの:
;   **調査のしかたを変える値**（フォルダの場所・関連オブジェクトの段数・PII キーワードなど）。
;   逆に、レポートの describe や SOQL の組み立てロジックは Python コードに書く。 config.ini に出すと
;   「触ってよい値」と「触ってはいけない値」が混ざり、どれを変えてよいか分からない。
;
; ルール:
;   - セクション名・キー名は大文字で書く（Python 側の config.SECTION.KEY と一致させる）
;     ただし、名前が MAPPING で終わるセクションの列名は実物どおりに書く
;   - 機密情報（パスワード・トークン・メールアドレス等）はここに書かない
;     → 社内の既存の管理方法を使う
;   - config.ini は .gitignore 済み（git に上がらない）。このテンプレートだけ git に含める
;
; セクション名は下の並びを使う（プロジェクトごとに違う名前を作らない）。
;   FILES       入力元・出力先のパス（フォルダもファイルもここ）
;   SURVEY      調査のしかた（関連オブジェクトの段数、2000 件チェックなど）
;   PII         個人情報の判定（キーワード、個人系オブジェクト）
;   〇〇_MAPPING 列の対応表              ← 使うときだけ
; どこに書くか迷わないように、名前は揃えてある。足りなければ足すより先に、
; 上のどれかに収まらないかを見る。
; =====================================================


[FILES]
; 入力元と出力先（環境によって変わる非機密の値）。
; パスは **この config.ini からの相対パス** で書くのが既定。基準は config.ini の
; 置かれているフォルダ（共有サーバーのように場所が固定のものだけ絶対パス／UNC を
; そのまま書いてよい）。区切り文字を含まない値（例: `INPUT_FOLDER = input`）は
; Path にならず str のままになるので、相対パスとして扱うには `./input` のように
; `./` を付ける。
; 出力先はローカルにする（NAS は読み込み元・置き場であり、新規出力先にはしない）
; **[FILES] の 7 つのキーはすべて必須**。 旧 config.ini にキーが無いと
; comken の ConfigError で止まる（既定値での補完はしない）。 値は下に
; 書いてあるので、 そのまま保存して書き換えるだけで動く。
;
; レポート管理表（Excel）。管理番号 / 概要 / Salesforce URL / 有効 などの列。
MASTER_XLSX_PATH = ./input/レポート管理表.xlsx

; describe 結果（ xlsx / csv ）の出力先フォルダ。
OUTPUT_DIR = ./output

; オブジェクト describe を実行をまたいで貯める CSV ファイル。
; 1 行 1 項目 （ 組織 / オブジェクト / オブジェクト表示名 / カスタムオブジェクト /
; 項目 API 名 / 項目表示名 / 型 / 参照先 / リレーション名 / カスタム項目 /
; 絞り込み可 / 並べ替え可 / 選択肢 / 取得日時 ） 。 レポートの describe は毎回
; Salesforce に聞くが、 オブジェクトの describe はここに貯めたものを使い、 無い
; ものだけ Salesforce に取りに行く。 削除すると全件取り直しになる。
DESCRIBE_CSV_PATH = ./data/項目定義.csv

; 人が Excel で開いて直す 「 列の直し 」 の xlsx パス。 シート 1 枚の Excel テーブル
; 形式で、 列: 状態 / 主オブジェクト / 表示名 / 列キー / 自動のSOQL列名 / 候補 /
; 直したSOQL列名 / メモ / 使っているレポート / 更新日。 自動で取れなかった列や、
; 自動の結果を人が直したいときに、 「 直したSOQL列名 」 列に値を入れる。 値は自動の
; 結果より常に優先され、 次の実行の対応表・SOQL 下書き・列名の対応.csv・Markdown
; 資料に使われる。 ファイルが無いときは自動の結果だけで動く。 旧 `data/列の対応.csv`
; （ メモ=手入力 かつ SOQL列名あり ） があるときは、 その値を 「 直したSOQL列名 」 に
; 引き継ぐ。
COLUMN_FIX_XLSX_PATH = ./input/列の直し.xlsx

; `OUTPUT_DIR/` 配下に書く Excel ファイル名。 人が見る 1 冊のブック。
XLSX_NAME = SOQL調査.xlsx

; `OUTPUT_DIR/` 配下に書く AI 向け Markdown のフォルダ名。 1 レポート 1 ファイル。
MARKDOWN_DIR = SOQL資料

; `OUTPUT_DIR/` 配下に書く Mermaid 関係図のフォルダ名。 主オブジェクト 1 つ 1 ファイル。
DIAGRAM_DIR = 関係図

; `列名の対応.csv` のファイル名は **ダウンローダーとの約束で固定** のため、 config
; からは外してある。 出力先は `OUTPUT_DIR/列名の対応.csv`。


[SURVEY]
; 調査のしかたを変える値。 旧バージョンのコードの定数 （ `src/fetch.py` /
; `src/run.py` ） をこちらに移したもの。 4 つのキーは **すべて必須**。
; キーが無いと comken の ConfigError で止まる。 値はあるが不正なときも
; （ 数値でない、 ○/× 以外 ） ConfigError で止まる。
;
; 主オブジェクトから何段まで関連オブジェクトを掘るか。 1 なら参照先 1 段だけ。
RELATED_DEPTH = 3

; 関連オブジェクトの合計件数の上限。 全段の合計がこの値を超えると打ち切り、
; 超えた分は警告に名前が残る。
RELATED_MAX = 40

; 1 レポートごとに 2000 行チェックを実行するか。 ○（ON） / ×（OFF）。
; OFF だと 「 2000件超 」 列が 「 未実施 」 になる。
ROW_LIMIT_CHECK = ○

; 似たレポート判定で 「 近い 」 とみなす Jaccard 類似度の下限。 0.0 〜 1.0。
SIMILAR_COLUMN_THRESHOLD = 0.8


[PII]
; 個人情報の判定。 旧バージョンのコードの定数 （ `src/pii.py` ） をこちらに移した
; もの。 2 つのキーは **すべて必須**。 キーが無いと comken の ConfigError で
; 止まる。
;
; 個人情報とみなすキーワード。 カンマ区切り。 判定ルールは docs/使い方.md を参照。
KEYWORDS = 氏名, 名前, 姓, 名, フリガナ, カナ, メール, email, 電話, phone, mobile, fax, 住所, street, city, state, postal, zip, 郵便, 生年月日, birth, 性別, gender, マイナンバー, 個人番号, 口座, 免許, パスポート, 年収, 給与

; 個人系オブジェクトの API 名。 カンマ区切り。 ここに挙げたオブジェクトか、 かつ
; `IsPersonAccount` 項目を持つ Account 上で、 キーワード一致の列が 「 あり 」 になる。
PERSON_OBJECTS = Contact, Lead, User, Individual, PersonAccount


; =====================================================
; 旧バージョンで使っていたセクション （ [LIMITS] / [SF] / [CHECKS] / [SIMILAR] /
; [OBJECTS] ） が config.ini に残っていても、 このツールは読まないので無視される。
; そのまま残しておいて OK。 関連オブジェクトの段数・キーワード・個人系オブジェクトは
; 上の `[SURVEY]` / `[PII]` に移した （ 2026-10-15 ）。
; =====================================================

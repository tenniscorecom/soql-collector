; =====================================================
; 初回に 実行.bat を1度動かすと、このファイルをもとに config.ini が作られて、
;   「値を書き換えてから、もう一度実行してください」と出て止まります。
;   そのあと config.ini（このファイルではない方）を開いて、実際の値に書き換える。
;
; ここに書くもの:
;   **非エンジニアが自分で変える値**（フォルダの場所・対象年月など）。
;   逆に、エンジニアしか触らない固定値は Python コードに書く。config.ini に出すと
;   「触ってよい値」と「触ってはいけない値」が混ざり、どれを変えてよいか分からない。
;
; ルール:
;   - セクション名・キー名は大文字で書く（Python 側の config.SECTION.KEY と一致させる）
;     ただし、名前が MAPPING で終わるセクションの列名は実物どおりに書く
;   - 機密情報（パスワード・トークン・メールアドレス等）はここに書かない
;     → 社内の既存の管理方法を使う
;   - config.ini は .gitignore 済み（git に上がらない）。このテンプレートだけ git に含める
;
; セクション名は下の並びを使う（プロジェクトごとに違う名前を作らない）。
;   FILES       入力元・出力先のパス（フォルダもファイルもここ）
;   LIMITS      取得件数・行数の上限
;   SF          Salesforce 関連
;   BROWSER     ブラウザの設定           ← 使うときだけ
;   〇〇_MAPPING 列の対応表              ← 使うときだけ
; どこに書くか迷わないように、名前は揃えてある。足りなければ足すより先に、
; 上のどれかに収まらないかを見る。
; =====================================================


[FILES]
; 入力元と出力先（環境によって変わる非機密の値）。
; パスは **この config.ini からの相対パス** で書くのが既定。基準は config.ini の
; 置かれているフォルダ（共有サーバーのように場所が固定のものだけ絶対パス／UNC を
; そのまま書いてよい）。区切り文字を含まない値（例: `INPUT_FOLDER = input`）は
; Path にならず str のままになるので、相対パスとして扱うには `./input` のように
; `./` を付ける。
; 出力先はローカルにする（NAS は読み込み元・置き場であり、新規出力先にはしない）
;
; レポート管理表（Excel）。**必須**。省略するとエラーで止まる
MASTER_XLSX_PATH = ./input/レポート管理表.xlsx

; describe 結果（JSON）の出力先フォルダ。省略時は ./output
OUTPUT_DIR = ./output


[LIMITS]
; 関連オブジェクト（参照先）の取得件数上限。主オブジェクトの fields から
; ``referenceTo`` を集めて打ち切る数。**全段の合計**に対する上限。超えた分は
; 警告に名前を残す
RELATED_MAX = 40

; 関連オブジェクトを掘る最大の段数。 1 なら参照先 1 段だけ （ 今までの挙動 ） 。
; 2 以上にすると、 ``Task.What.Account.Owner`` のように参照先をたどって掘る。
; 1 以上でなければならない
RELATED_DEPTH = 3


[SF]
; Salesforce 認証情報のシステム名接頭辞。comken の ``comken cred`` で登録した
; 名前の先頭に付く（既定は空 = 実行環境と同じ名前を使う）
; CREDENTIAL_PREFIX =


[CHECKS]
; レポートごとに 「 2000 行超か 」 のチェックを実行するか。 レポートは
; 1 回ずつ実行するので時間がかかる。 チェックを止めたいときだけ × にする
; ○ … 実行する （ 既定 ）
; × … 実行しない （ 調査表の 2000件超 列が 「 未実施 」 になる ）
; ROW_LIMIT = ○


[PII]
; 個人情報（ PII ） の判定に使うキーワードと個人系オブジェクト。 判定は目安で
; 最終判断は人が行う。 判定が曖昧なものは 「 要確認 」 に倒す
; 未設定 / 空なら既定値を使う。 値を書くとその値に置き換わる
;
; キーワード: レポート列の表示名 / API 名との一致のさせ方は 一律ではなく
; 次のように 3 段階:
;   - 1 文字の日本語キーワード （ 姓 / 名 ）: 表示名が **完全一致** するなら一致
;   - ASCII キーワード （ email / phone / city / state / birth など ）: API 名 /
;     表示名をトークン分解し トークンが **一致** するなら一致 （ birth はトークン
;     の **先頭一致** も可 ）
;   - 上記以外の日本語キーワード （ 2 文字以上 ）: 従来どおり **部分一致**
;     （ 大文字小文字を無視 ）
; 既定は 「 氏名 / 名前 / 姓 / 名 / フリガナ / カナ / メール / email / 電話 /
; phone / mobile / fax / 住所 / street / city / state / postal / zip / 郵便 /
; 生年月日 / birth / 性別 / gender / マイナンバー / 個人番号 / 口座 / 免許 /
; パスポート / 年収 / 給与 」
; KEYWORDS = 氏名,名前,メール,電話
;
; 個人系オブジェクト: キーワードが一致したときに 「 あり 」 と判定するオブジェクト名。
; Account でも項目に IsPersonAccount がある場合は 個人系扱い
; 既定は 「 Contact, Lead, User, Individual, PersonAccount 」
; OBJECTS = Contact,Lead,User


[SIMILAR]
; 似たレポート判定で 「 近い 」 とみなす出力列の Jaccard 類似度の下限。 0 〜 1
; 既定は 0.8。 値を下げると より多くのレポートが 「 近い 」 になる
; COLUMN_SIMILARITY = 0.8


[BROWSER]
; ブラウザ自動操作を使う場合。HEADLESS = True で画面を出さずに動かす
; HEADLESS = False
